# Copy this file to .env in the repository root before running Docker Compose.

# Where visitors reach the site; share cards link to it
SITE_URL=http://localhost:3000

# VLM: an OpenAI-compatible API that captions memes
VLM_MODEL=your-model-name
VLM_API_KEY=your-api-key
VLM_BASE_URL=https://api.example.com/v1

# GPU: inference runs on the CPU; uncomment one line for an NVIDIA or an Intel GPU
# COMPOSE_FILE=docker-compose.yaml:docker-compose.cuda.yaml
# COMPOSE_FILE=docker-compose.yaml:docker-compose.xpu.yaml

# Mirror for the model weights inference downloads
HF_ENDPOINT=https://huggingface.co
# For mirrors without Xet storage
# HF_HUB_DISABLE_XET=1
# For gated models
# HF_TOKEN=

# Building inference: mirrors for Python packages and PyTorch
UV_DEFAULT_INDEX=https://pypi.org/simple
# PyTorch's index for the CPU or an Intel GPU (download.pytorch.org/whl/cpu or /xpu); CUDA's is UV_DEFAULT_INDEX
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Needs Python 3.12+ and uv, on Debian Trixie for an Intel GPU
# INFERENCE_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-trixie-slim

# Building inference for an Intel GPU: mirrors for its runtime, and its versions
APT_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
# GITHUB_RELEASE_BASE_URL=https://github.com
# IGC=2.41.5+22716
# NEO=26.35.39758.10
# GMM=22.10.0
# LEVEL_ZERO=1.34.0

# Building the web yourself (docker compose up -d --build)
# NPM_REGISTRY=https://registry.npmmirror.com
