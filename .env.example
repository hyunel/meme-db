# Copy this file to .env in the repository root before running Docker Compose.
SITE_URL=http://localhost:3000

# Fill in your OpenAI-compatible VLM provider's settings.
VLM_MODEL=your-model-name
VLM_API_KEY=your-api-key
VLM_BASE_URL=https://api.example.com/v1

# Inference runs on the CPU. For an NVIDIA GPU uncomment the first line, for an Intel GPU the second.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.cuda.yaml
# COMPOSE_FILE=docker-compose.yaml:docker-compose.xpu.yaml

# Optional build-time override; provide Python 3.12+, uv, and Debian Trixie for XPU.
# INFERENCE_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-trixie-slim

# Replace these URLs with your mirrors. Python dependencies are installed at startup.
UV_DEFAULT_INDEX=https://pypi.org/simple
HF_ENDPOINT=https://huggingface.co

# Unset: CUDA uses UV_DEFAULT_INDEX; CPU/XPU use download.pytorch.org/whl/cpu or /xpu.
# Set a full backend-specific index URL to override PyTorch downloads.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# HF_TOKEN=
# HF_HUB_DISABLE_XET=1

# Intel XPU runtime downloads; unused for CPU and CUDA.
APT_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
# GITHUB_RELEASE_BASE_URL=https://github.com
# IGC=2.41.5+22716
# NEO=26.35.39758.10
# GMM=22.10.0

# Docker persists /cache. Virtual environments are separated by Python ABI,
# architecture, and TORCH; use distinct paths if overriding their location.
# INFERENCE_CACHE_DIR=/cache
# UV_PROJECT_ENVIRONMENT=/cache/venvs/custom-cpu
# UV_CACHE_DIR=/cache/uv
# HF_HOME=/cache/huggingface
# TORCHINDUCTOR_CACHE_DIR=/cache/torchinductor
